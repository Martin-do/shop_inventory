# Copy to /etc/shop_inventory.env on the server and fill in real values.
# The filled-in file must never be committed.
#
# Owner root, group www-data, mode 640:
#   sudo chown root:www-data /etc/shop_inventory.env && sudo chmod 640 /etc/shop_inventory.env

# Generate once, on the server, with:
#   .venv/bin/python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=replace-with-a-long-random-value

# Production must never run in debug mode.
DEBUG=0

# Names this app answers on: comma separated, no scheme, no port.
ALLOWED_HOSTS=lekepee.com.ng,www.lekepee.com.ng

# Public origins WITH scheme, so form posts are accepted.
CSRF_TRUSTED_ORIGINS=https://lekepee.com.ng,https://www.lekepee.com.ng

# Nginx sits in front and sets X-Forwarded-For / X-Forwarded-Proto.
TRUST_FORWARDED_FOR=1

# Nginx already redirects HTTP to HTTPS, so Django need not.
SECURE_SSL_REDIRECT=0

# --- Only while the old plain-HTTP :8010 address is still in use ---------------
# Secure cookies are never sent over HTTP, so logins on :8010 fail without these.
# Delete both lines (and the :8010 entries above) once :8010 is closed.
#SESSION_COOKIE_SECURE=0
#CSRF_COOKIE_SECURE=0
#ALLOWED_HOSTS=lekepee.com.ng,www.lekepee.com.ng,shcssibadan.com.ng,147.124.223.97,66.92.247.9
#CSRF_TRUSTED_ORIGINS=https://lekepee.com.ng,https://www.lekepee.com.ng,http://shcssibadan.com.ng:8010,http://147.124.223.97:8010
# -------------------------------------------------------------------------------

# Session length in seconds (12 hours covers a shop day).
SESSION_COOKIE_AGE=43200

# Failed logins allowed per account and per address before a cool-down.
LOGIN_ATTEMPT_LIMIT=8
LOGIN_ATTEMPT_COOLDOWN_SECONDS=900

LOG_LEVEL=INFO
